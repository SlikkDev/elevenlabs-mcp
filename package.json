{
  "name": "@slikkdev/elevenlabs-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local stdio MCP server for ElevenLabs voices, text-to-speech, and music generation.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/SlikkDev/elevenlabs-mcp.git" },
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.33.0",
  "bin": { "elevenlabs-mcp": "dist/index.js" },
  "files": ["dist/*.js", "README.md", "LICENSE", "SECURITY.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
